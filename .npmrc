# Mirrors frontend/.npmrc. Since package.json declares `workspaces:
# ["frontend"]`, Cloudflare Pages' v2 build system detects the monorepo and
# runs `npm install` from this directory (the repo root) rather than from
# frontend/ — so frontend/.npmrc alone no longer reaches that install.
#
# Without this, npm runs its full peer-dependency resolver over the
# transaction-kit / wagmi / RainbowKit peer graph and hits a long-standing
# npm bug in that code path (Arborist #loadPeerSet throwing "Cannot read
# properties of null (reading 'edgesOut')" — npm/cli#8261, #9787, #9960).
# legacy-peer-deps skips that resolver entirely, avoiding the crash.
legacy-peer-deps=true
