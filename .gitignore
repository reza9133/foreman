# The root lockfile IS committed on purpose: CI runs `npm ci` (which requires
# it) and frontend/__tests__/release-dependencies.test.ts asserts on the pinned
# GenLayer RC versions recorded in it. Only the nested frontend lockfile, which
# npm workspaces makes redundant, is ignored (see /frontend/package-lock.json
# above).

*.tsbuildinfo
