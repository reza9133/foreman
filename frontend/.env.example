# Deployed Foreman contract address (see ../deploy/deployScript.ts)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xa30086E09B2B47645167182653ec55702e57B20b

# Optional overrides — all default to GenLayer Studionet (chain id 61999,
# https://studio.genlayer.com/api) via the SDK's `studionet` preset. Only set
# these if you need to point at a different network, and change the RPC URL
# and chain id together.
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
# NEXT_PUBLIC_GENLAYER_CHAIN_NAME=Genlayer Studio Network
# NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
